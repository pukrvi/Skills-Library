{
  "course": {
    "title": "Enterprise Discovery Fundamentals",
    "description": "A self-paced course for enterprise AEs to improve discovery quality by practicing impact-oriented follow-up questions.",
    "category": "Sales Onboarding",
    "target_audience": "New enterprise AEs",
    "difficulty": "intermediate",
    "estimated_duration_minutes": 65,
